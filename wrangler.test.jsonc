{
  // ============================================================================
  // TEST relayer 配置档（本地联调：hub=31339 sandbox3 ↔ spoke=31338 sandbox2，均本机 hardhat 链）
  // ——与生产 wrangler.jsonc 完全隔离。生产 wrangler.jsonc 不读本档；本档只被显式
  // `-c wrangler.test.jsonc` 使用：
  //   本地彩排：       wrangler dev -c wrangler.test.jsonc --test-scheduled --local
  //                    wrangler d1 migrations apply stapleport-bridge-db-test --local -c wrangler.test.jsonc
  // 密钥走 .dev.vars（本地，软链 ../../secrets/bridge-test.dev.vars，gitignore）。
  // authority = 热句 idx107 0x2ED19F69F3C54FA3Ea2B8B7EC0C43997A267A459（L1 部署用同址）。
  // 地址来源：deployments/node31339/StapleportBridge.json + deployments/node31338/{OutVault,
  // StapleportBridgedToken}.json（只读引用，勿在本档手抄改值——回填时从该档取）。
  // ============================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stapleport-bridge-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",

  // 零公网面：cron + GET /health（同生产口径）
  "workers_dev": false,
  "triggers": {
    "crons": ["* * * * *"]
  },

  // 顶层 = 本地联调拓扑（31339 hub + 31338 spoke）。更轻的 mock 彩排用 env.local 覆盖（见下）。
  "vars": {
    // ---- hub（31339 本地 StapleportBridge 门面）----
    "HUB_CHAIN_ID": "31339",
    "RPC_URL_HUB": "http://127.0.0.1:8547",
    // deployments/node31339/StapleportBridge.json 的 proxy（门面三件=同一代理地址）。
    "SPBRIDGE": "0x3cBAB02221A26f46c512ffFa91Cc5854C96cc194",
    // 本 relayer key 作为通道 authority 的目标地址（仅记录，供核对；运行时由私钥派生）
    "BRIDGE_AUTHORITY": "0x2ED19F69F3C54FA3Ea2B8B7EC0C43997A267A459",

    // ---- 入向通道：本测试只做出向家族（D3），入向不开 ----
    "CHANNELS": "[]",

    // ---- 出向通道：hub 锁 TAT(ERC20) → spoke 铸 OutToken-spN ----
    // 字段语义：token = spoke 侧 spN(OutToken)；srcToken = hub 侧锁仓 ERC20
    //（=地址档 hub.outToken）；presence ⇒ ERC20 出向分支（relay 回程走 executeOutReleaseERC20/
    // outReleasedErc20/outStandingErc20）；缺省 = native。去费版删 covered 预检/gas 边际字段。
    // 单通道硬约束：同一 chainIndex 至多一条出向通道——本拓扑只配 TAT ERC20、native 出向不开启。
    // 地址档（deployments/node31338/{OutVault,StapleportBridgedToken}.json + node31339/TAT.json）：
    // [{ chainIndex, vault(node31338 OutVault), token(node31338 StapleportBridgedToken), srcToken(node31339 TAT) }]
    "OUT_CHANNELS": "[{\"chainIndex\":\"1\",\"vault\":\"0x0B4Ce84dFbC2048B142A7Ca87e7099D695a940fC\",\"token\":\"0x5D433BeAea98d30e98950599b79C5bCFfDd278ab\",\"srcToken\":\"0xD74E1a5c9B00C61617b26e31E205cFf2434A8b7F\"}]",

    // ---- 源链（spoke）清单：spoke=31338 本机链，confirmations=2；hub 侧确认数默认 2 ----
    // rpc 可单条或数组（多条=失败轮换备援，RPC 单点缓解；首条 primary）：
    // "{\"<chainIndex>\":{\"rpc\":[\"http://127.0.0.1:8546\"],\"confirmations\":2},\"hub\":{\"confirmations\":2}}"
    "SRC_CHAINS": "{\"1\":{\"rpc\":\"http://127.0.0.1:8546\",\"confirmations\":2},\"hub\":{\"confirmations\":2}}",

    // ---- onboarding 关闭（本测试走 vars 直配；链注册表直读 spBridge 门面）----
    "API_BASE": "",

    // ---- 行为 ----
    "TICK_LOCK_SECONDS": "55",
    "MAX_ATTEMPTS": "16",
    "DRY_RUN": "false",
    "WEBHOOK_URL": ""
  },

  "env": {
    // 本地彩排档：hardhat hub-mock=31337(8545) + spoke-mock=31338(8546)。
    // spoke 地址取自 registry.json 31338 桶现存部署；hub 地址待 L1 在 31337 部署后回填。
    "local": {
      "name": "stapleport-bridge-test-local",
      "vars": {
        "HUB_CHAIN_ID": "31337",
        "RPC_URL_HUB": "http://127.0.0.1:8545",
        // 取 deployments/bridge-test-local.json（L1）：门面三件=同一代理地址
        "SPBRIDGE": "0x1eCB8071010ba3DFAd1EC09dC64f88Ba2B6c8204",
        "BRIDGE_AUTHORITY": "0x2ED19F69F3C54FA3Ea2B8B7EC0C43997A267A459",
        "CHANNELS": "[]",
        // token=spoke spN(OutToken 0x4fCe…)；srcToken=hub 锁仓 TAT mock(0xEDbD…，=档 hub.outToken)
        "OUT_CHANNELS": "[{\"chainIndex\":\"1\",\"vault\":\"0xe89B1674DC14C30f5C321Cfd0F60c06826E81E41\",\"token\":\"0x4fCee3dBF87D360480d0daE4D97893522F548A65\",\"srcToken\":\"0xEDbDEF27BB38842Cc84CBDbd82c30B1afD447C57\"}]",
        // 本地冒烟：确认数置 0 即时处理（档值为 hub 1/spoke 12，实弹用）
        "SRC_CHAINS": "{\"1\":{\"rpc\":\"http://127.0.0.1:8546\",\"confirmations\":0},\"hub\":{\"confirmations\":0}}",
        "API_BASE": "",
        "TICK_LOCK_SECONDS": "1",
        "MAX_ATTEMPTS": "3",
        "DRY_RUN": "false",
        // vars 不被 wrangler 环境继承——env.local 必须列全（否则回落 config.js 缺省）
        "WEBHOOK_URL": ""
      },
      // d1_databases 同样不被环境继承——env.local 必须自带，否则 BRIDGE_DB 未绑定
      "d1_databases": [
        {
          "binding": "BRIDGE_DB",
          "database_name": "stapleport-bridge-db-test",
          "database_id": "e8090b85-b953-45c3-a0c2-f7b148826356"
        }
      ]
    }
  },

  // ---- D1（必绑）：游标 + ops 幂等表 ----
  // 本地彩排：--local 走 .wrangler/state 本地 sqlite，database_id 不校验（占位可）。
  // 实弹：wrangler d1 create stapleport-bridge-db-test → 把真 id 填到 database_id。
  "d1_databases": [
    {
      "binding": "BRIDGE_DB",
      "database_name": "stapleport-bridge-db-test",
      "database_id": "e8090b85-b953-45c3-a0c2-f7b148826356"
    }
  ]
}
