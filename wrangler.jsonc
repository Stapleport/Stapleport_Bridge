{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stapleport-bridge",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",

  // 零公网面：只有 cron 触发 + GET /health。relayer 不需要任何入站路由——
  // 它是「主动出站」的执行客户端：监听事件 → 签名发交易（骨架照抄 SelfSweep）。
  "workers_dev": false,

  // 每分钟一轮：正向（源链 Deposit → stapleport mint）+ 反向（stapleport BurnRequest → 源链 release）
  // + 出向正向（stapleport LockOut → 外链铸 spN）+ 出向反向（外链 BurnOut → stapleport 解锁）。
  // 想更快改 "*/1" 之外可自行加密（多实例同 key 幂等安全，gas 白烧而已）
  "triggers": {
    "crons": ["* * * * *"]
  },

  // 公开配置（非敏感）。密钥只有一把 BRIDGE_RELAYER_PRIVATE_KEY（= 通道 authority 地址），
  // 走 wrangler secret，绝不放这里：wrangler secret put BRIDGE_RELAYER_PRIVATE_KEY
  "vars": {
    // ---- hub（stapleport 端）----
    // spBridge 地址（registry.json 为底，可用 SPBRIDGE / RPC_URL_HUB 覆盖）
    "HUB_CHAIN_ID": "78753",
    "SPBRIDGE": "",

    // ---- 通道清单（JSON 数组）：本 key 作为 authority 服务的通道 ----
    // chainIndex 用链注册表颁发的索引；srcDecimals 用于精度换算（→18 无损放大 / 18→src floor）
    "CHANNELS": "[]",

    // ---- 出向通道清单（JSON 数组）：stapleport native → 外链表示币 spN ----
    // [{ chainIndex, vault(OutVault 地址), token(spN 地址), srcToken?(hub 锁仓 ERC20；presence ⇒ ERC20 出向) }]
    "OUT_CHANNELS": "[]",

    // ---- 源链清单（JSON 对象）：chainIndex → { rpc?, confirmations? } ----
    // rpc 缺省读 registry.json，registry 外的链必须给；confirmations 防重组（野链按尽调定，默认 3）
    "SRC_CHAINS": "{}",

    // ---- E流 自动 onboarding（可选；API_BASE 空 = 关闭，行为与旧版完全一致）----
    // 非空时每轮 cron 先于四向中继跑 onboardingTick：拉 <API_BASE>/v1/chains?project=bridge
    // 的 active 链 → hub ChainRegistry 幂等注册 → spoke setChainIndex 后配 → 检测人工已开
    // 出向通道（getOutChannel authority 非 0）→ active 后链拓扑由派生层并入运行时 config
    // （vars 里的条目永远优先）。开通道 MANAGE-only 转人工，relayer 热钥不授 MANAGE。
    "API_BASE": "",

    // ---- 费率 oracle（bridge-fee 费率面 §3.3；非敏感 URL 走 vars，非 secret）----
    // 准入/裁决重估的 gasPrice+原生币价原料源；空 = 全走 kit FALLBACK 保守值（能跑但门槛失真）。
    // 生产=CF oracle（已部署，chainId 97/31337/31338 面）；本地彩排 runner（relay-local-e.mjs）
    // 不读这里，自指本地 oracle dev 8799——本地链 CF 不可达（unreachable 属预期）。
    "ORACLE_BASE": "https://stapleport-oracle.kflc.workers.dev",

    // ---- 行为 ----
    // tick 内存锁：防同 isolate 重叠
    "TICK_LOCK_SECONDS": "55",
    // 单 op 重试上限：缺省 16≈15min 窗口内每 tick 一次+退款落地余量；超过后告警并保持 pending（env 覆盖仍优先）
    "MAX_ATTEMPTS": "16",
    // true = 只打印将发的交易，不广播
    "DRY_RUN": "false",
    // 可选：事件告警 webhook（POST JSON）
    "WEBHOOK_URL": ""
  },

  // ---- D1（必绑）：游标 + ops 幂等表。双保险的第二层（第一层在合约幂等）----
  // wrangler d1 create stapleport-bridge-db 后把 id 填进来再 deploy
  "d1_databases": [
    {
      "binding": "BRIDGE_DB",
      "database_name": "stapleport-bridge-db",
      "database_id": "REPLACE_WITH_D1_ID"
    }
  ]
}
